{
  "name": "STUDIO DE ANTO · Virello preservado",
  "build": {
    "dockerfile": "../studio-de-anto/.devcontainer/Dockerfile",
    "context": "../studio-de-anto/.devcontainer"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "containerEnv": {
    "STUDIO_BOOTSTRAP_MODEL": "1",
    "STUDIO_MODEL": "qwen2.5:3b"
  },
  "forwardPorts": [
    8765
  ],
  "portsAttributes": {
    "8765": {
      "label": "STUDIO DE ANTO",
      "onAutoForward": "notify",
      "protocol": "http",
      "requireLocalPort": true
    }
  },
  "postCreateCommand": "cd studio-de-anto && bash scripts/install.sh",
  "postStartCommand": "cd studio-de-anto && bash scripts/start-cloud.sh --background && .venv/bin/python scripts/setup-model.py --test",
  "shutdownAction": "stopContainer",
  "remoteUser": "vscode",
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  }
}
