{
  "name": "STUDIO DE ANTO · Virello preservado",
  "build": {
    "dockerfile": "../studio-de-anto/.devcontainer/Dockerfile",
    "context": "../studio-de-anto/.devcontainer"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "containerEnv": {
    "STUDIO_CLOUD_ONLY": "1"
  },
  "forwardPorts": [
    8765
  ],
  "portsAttributes": {
    "8765": {
      "label": "STUDIO DE ANTO",
      "onAutoForward": "notify",
      "protocol": "http",
      "requireLocalPort": true
    }
  },
  "postCreateCommand": "cd studio-de-anto && bash scripts/install.sh",
  "postStartCommand": "cd studio-de-anto && bash scripts/start-cloud.sh --background",
  "shutdownAction": "stopContainer",
  "remoteUser": "vscode",
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "secrets": {
    "STUDIO_GEMINI_API_KEY": {
      "description": "Clave Gemini: AI en la nube (cuotas según tu cuenta)"
    },
    "STUDIO_GROQ_API_KEY": {
      "description": "Clave Groq: alternativa AI en la nube (opcional)"
    }
  }
}
