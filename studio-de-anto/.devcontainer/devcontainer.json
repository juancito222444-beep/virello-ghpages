{
  "name": "STUDIO DE ANTO · nube privada",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "containerEnv": {
    "STUDIO_BOOTSTRAP_MODEL": "1",
    "STUDIO_MODEL": "qwen3.5:2b-q4_K_M"
  },
  "forwardPorts": [
    8765
  ],
  "portsAttributes": {
    "8765": {
      "label": "STUDIO DE ANTO",
      "onAutoForward": "notify",
      "protocol": "http",
      "requireLocalPort": true
    }
  },
  "postCreateCommand": "bash scripts/install.sh",
  "postStartCommand": "bash scripts/start-cloud.sh --background && .venv/bin/python scripts/setup-model.py --test",
  "shutdownAction": "stopContainer",
  "remoteUser": "vscode",
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  }
}
