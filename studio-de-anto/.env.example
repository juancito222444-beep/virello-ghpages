# No contiene credenciales. Ollama se configura desde la aplicación.
# Directorio opcional de datos (ruta absoluta):
# ANTO_DATA_DIR=/ruta/privada/studio-data
# Activar únicamente durante una instalación donde quieras descargar el modelo:
# STUDIO_BOOTSTRAP_MODEL=1
# Ollama portable ya instalado (opcional):
# STUDIO_OLLAMA_BIN=/ruta/ollama/bin/ollama
# Ubicación de pesos si no quieres usar local-data/models/ollama:
# STUDIO_OLLAMA_MODELS=/ruta/privada/modelos
